# ==============================================================================
# ConflictGuard — Environment configuration template
#
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`
# file — it is already excluded via .gitignore.
#
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM PROVIDER — choose ONE primary path.
# ConflictGuard supports calling models either directly via OpenAI, or routed
# through the Portkey AI gateway (for caching, fallback, observability, and
# multi-provider routing). If PORTKEY_API_KEY is set, the app prefers Portkey;
# otherwise it falls back to calling OpenAI directly with OPENAI_API_KEY.
# ------------------------------------------------------------------------------

# Option A: Direct OpenAI access
OPENAI_API_KEY=

# Option B: Portkey AI Gateway (recommended for Tier 3 observability/caching)
PORTKEY_API_KEY=
# Virtual key configured in your Portkey dashboard that maps to an underlying
# provider (e.g. OpenAI, Anthropic). Required only if using Portkey.
PORTKEY_VIRTUAL_KEY=

# ------------------------------------------------------------------------------
# MODEL SELECTION
# ------------------------------------------------------------------------------
# Chat/completion model used by the agents (intake, search, risk analysis).
LLM_MODEL=gpt-4o-mini

# Embedding model used for local RAG similarity search over client records.
# Leave blank to fall back to a local sentence-transformers model (no API key
# needed, runs entirely offline).
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Path to the mock/historical client dataset used to build the local vector store.
CLIENT_DATA_PATH=data/mock_clients.json

# Directory where the local Chroma vector store persists its index.
VECTOR_STORE_DIR=data/vector_store

# Minimum similarity score (0-1) for a retrieved past matter to be flagged as a
# potential conflict and passed to the Risk Analysis agent.
CONFLICT_SIMILARITY_THRESHOLD=0.75

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
